[Unit]
Description=Apply ASUS G14 battery charge limit of 80 percent
After=systemd-modules-load.service
ConditionPathExists=/sys/class/power_supply/BAT1/charge_control_end_threshold

[Service]
Type=oneshot
ExecStart=/usr/bin/tee /sys/class/power_supply/BAT1/charge_control_end_threshold
StandardInput=data
StandardInputText=80
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
