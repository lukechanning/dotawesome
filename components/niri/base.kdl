// Portable baseline. Machine outputs, workspaces and command bindings are appended.
input {
    keyboard {
        xkb {
            // Match KDE: the ISO < > key beside left Shift is another Shift.
            options "lv2:lsgt_switch"
        }
    }
    touchpad { tap; natural-scroll; }
    mouse { natural-scroll; }
}
// Shared desk monitor: match its identity across machines and connectors.
// Leave mode and placement automatic; only persist the tested scale.
output "PNP(AOC) 27B36X XI7S4HA042988" {
    scale 0.85
}
layout {
    gaps 8
    background-color "#161821"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    focus-ring {
        width 2
        active-color "#8fbdab"
        inactive-color "#4b5b55"
    }
    border { off; }
    shadow {
        on
        softness 18
        spread 0
        offset x=0 y=3
        color "#080e1659"
    }
}
// Short transitions aid spatial navigation; glass effects are shell-only.
animations {
    workspace-switch { duration-ms 150; curve "ease-out-cubic"; }
    horizontal-view-movement { duration-ms 150; curve "ease-out-cubic"; }
    window-movement { duration-ms 150; curve "ease-out-cubic"; }
    window-resize { duration-ms 150; curve "ease-out-cubic"; }
    window-open { duration-ms 120; curve "ease-out-cubic"; }
    window-close { duration-ms 100; curve "ease-out-quad"; }
    overview-open-close { duration-ms 150; curve "ease-out-cubic"; }
    recent-windows-close { duration-ms 120; curve "ease-out-cubic"; }
}
// Niri owns switching; no second Noctalia window switcher.
recent-windows {
    open-delay-ms 150
    highlight { corner-radius 6; }
    binds {
        Alt+Tab { next-window; }
        Alt+Shift+Tab { previous-window; }
        Mod+Tab { next-window; }
        Mod+Shift+Tab { previous-window; }
        Alt+grave { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}
hotkey-overlay { skip-at-startup; }
prefer-no-csd
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
}
// Noctalia requests blur for its rounded regions via ext-background-effect.
// Do not force effects on its full-screen panel input surfaces.
binds {
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    // Monitor navigation is separate from movement within the tiled layout.
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-window-to-monitor-left; }
    Mod+Ctrl+Shift+J { move-window-to-monitor-down; }
    Mod+Ctrl+Shift+K { move-window-to-monitor-up; }
    Mod+Ctrl+Shift+L { move-window-to-monitor-right; }
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+Shift+1 { move-window-to-workspace "1"; }
    Mod+Shift+2 { move-window-to-workspace "2"; }
    Mod+Shift+Q { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+R { switch-preset-column-width; }
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }
    Mod+W { toggle-column-tabbed-display; }
// @DOTAWESOME_COMMAND_BINDS@
    Mod+Shift+S { screenshot; }
    Print { screenshot; }
    Mod+Shift+E { quit; }
}
