#!/bin/sh
set -eu

addon=$(dirname -- "$0")/addons/RadiumCouchUI

test -f "$addon/RadiumCouchUI.toc"
test -f "$addon/RadiumCouchUI.lua"
grep -Fq '## Interface: 30300' "$addon/RadiumCouchUI.toc"
grep -Fq 'ReserveBottom = 210' "$addon/RadiumCouchUI.lua"
grep -Fq 'LayoutChat' "$addon/RadiumCouchUI.lua"
grep -Fq 'LayoutNavigation' "$addon/RadiumCouchUI.lua"
grep -Fq 'LayoutBags' "$addon/RadiumCouchUI.lua"
grep -Fq 'FCF_SavePositionAndDimensions' "$addon/RadiumCouchUI.lua"
grep -Fq 'ConsolePortBarPet' "$addon/RadiumCouchUI.lua"
grep -Fq 'BindControllerChords' "$addon/RadiumCouchUI.lua"
grep -Fq 'CLICK ConsolePortBarPet:MiddleButton' "$addon/RadiumCouchUI.lua"
grep -Fq 'CLICK RadiumCouchUIBotMenuToggle:LeftButton' "$addon/RadiumCouchUI.lua"
grep -Fq 'chords["SHIFT-"] = self.BotMenuBinding' "$addon/RadiumCouchUI.lua"
grep -Fq 'chords["CTRL-"] = self.PetRingBinding' "$addon/RadiumCouchUI.lua"
grep -Fq 'MultiBot.ToggleMainUIVisibility(false)' "$addon/RadiumCouchUI.lua"
grep -Fq 'ConsolePort:AddFrame(bar)' "$addon/RadiumCouchUI.lua"
grep -Fq 'label = "Pet Ring"' "$addon/RadiumCouchUI.lua"
grep -Fq 'LayoutMinimapButtons' "$addon/RadiumCouchUI.lua"
grep -Fq 'MinimapButtonAngles = { DBM = 0, AtlasLoot = 142, MultiBot = 194 }' "$addon/RadiumCouchUI.lua"
grep -Fq 'MinimapZoneTextButton' "$addon/RadiumCouchUI.lua"
grep -Fq 'MenuScale = 0.95' "$addon/RadiumCouchUI.lua"
grep -Fq 'frame.GetEffectiveScale and frame or frame:GetParent()' "$addon/RadiumCouchUI.lua"
grep -Fq 'pcall(Addon[step]' "$addon/RadiumCouchUI.lua"
grep -Fq 'OptionalDeps: Immersion, MultiBot, AtlasLoot_Loader, DBM-Core' "$addon/RadiumCouchUI.toc"
if grep -Fq 'SetPetRingVisibility' "$addon/RadiumCouchUI.lua"; then
	echo 'pet ring must stay visible when a combat pet is out' >&2
	exit 1
fi
if command -v luac5.1 >/dev/null 2>&1; then luac5.1 -p "$addon/RadiumCouchUI.lua"; fi
grep -Fq 'SetupImmersionController' "$addon/RadiumCouchUI.lua"
grep -Fq 'SetOverrideBindingClick' "$addon/RadiumCouchUI.lua"
grep -Fq 'LayoutImmersion' "$addon/RadiumCouchUI.lua"
grep -Fq 'DefaultImmersionY = 205' "$addon/RadiumCouchUI.lua"
grep -Fq '## SavedVariables: RadiumCouchUIConfig' "$addon/RadiumCouchUI.toc"
grep -Fq 'SLASH_RADIUMCOUCHUI1' "$addon/RadiumCouchUI.lua"
grep -Fq 'SetupLayoutEditor' "$addon/RadiumCouchUI.lua"
grep -Fq 'ResetLayout' "$addon/RadiumCouchUI.lua"
grep -Fq 'SetCVar("uiScale", "1.0")' "$addon/RadiumCouchUI.lua"
grep -Fq 'UIParent:SetScale(1.04)' "$addon/RadiumCouchUI.lua"
grep -Fq 'EnableEditorBindings' "$addon/RadiumCouchUI.lua"
grep -Fq 'CP_L_UP' "$addon/RadiumCouchUI.lua"
grep -Fq 'LB/RB select' "$addon/RadiumCouchUI.lua"
grep -Fq 'Player Status' "$addon/RadiumCouchUI.lua"
grep -Fq 'Buffs / Status' "$addon/RadiumCouchUI.lua"
grep -Fq 'SetUserPlaced(true)' "$addon/RadiumCouchUI.lua"
grep -Fq 'UIParent_ManageFramePositions' "$addon/RadiumCouchUI.lua"
grep -Fq 'CP_R_RIGHT", function() Addon:LockLayout()' "$addon/RadiumCouchUI.lua"
grep -Fq 'return BuffButton1 or BuffFrame' "$addon/RadiumCouchUI.lua"
grep -Fq 'BuffFrame_UpdateAllBuffAnchors' "$addon/RadiumCouchUI.lua"
grep -Fq 'auraAnchor = "BuffButton1"' "$addon/RadiumCouchUI.lua"
