grep -Fq 'ConsolePortBarPet' "$addon/RadiumCouchUI.lua"
grep -Fq 'BindPetRing' "$addon/RadiumCouchUI.lua"
grep -Fq 'CLICK ConsolePortBarPet:MiddleButton' "$addon/RadiumCouchUI.lua"
grep -Fq 'CP_T_R3["SHIFT-"]' "$addon/RadiumCouchUI.lua"
grep -Fq 'SetupImmersionController' "$addon/RadiumCouchUI.lua"
grep -Fq 'SetOverrideBindingClick' "$addon/RadiumCouchUI.lua"
grep -Fq 'LayoutImmersion' "$addon/RadiumCouchUI.lua"
