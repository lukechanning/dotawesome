#!/bin/sh
set -eu
. "$(dirname -- "$0")/common.sh"
require_radium
retail=${1:-${WOW_RETAIL_PATH:-/mnt/hive/NonSteam/Blizzard/battlenet/drive_c/Program Files (x86)/World of Warcraft}}
[ -n "$retail" ] && [ -d "$retail" ] || { echo "Usage: wow client-build RETAIL_PATH" >&2; exit 2; }
builder=$WOW_ROOT/source/wotlk-hd
[ -d "$builder/.git" ] || { echo "wow: missing $builder" >&2; exit 1; }
[ -f "$WOW_ROOT/client/base/Wow.exe" ] || { echo "wow: stock client is not ready" >&2; exit 1; }
[ -f "$retail/_retail_/Wow.exe" ] || { echo "wow: Retail installation is incomplete: $retail" >&2; exit 1; }
[ -S "${DOCKER_HOST#unix://}" ] || { echo "wow: rootless Docker is not running" >&2; exit 1; }
if [ ! -f "$WOW_ROOT/client/hd/Wow.exe" ]; then
	rsync -a --delete "$WOW_ROOT/client/base/" "$WOW_ROOT/client/hd/"
	chmod -R u+w "$WOW_ROOT/client/hd"
fi
docker build --tag radium/wotlk-hd "${builder}"
docker run --rm \
	--volume "$builder:/src" \
	--volume "$WOW_ROOT/client/hd:/wow" \
	--volume "$retail:/retail" \
	radium/wotlk-hd
[ -f "$WOW_ROOT/client/hd/Wow-hd.exe" ]
[ -f "$WOW_ROOT/client/hd/dinput8.dll" ]

# Keep stock WotLK creature models while retaining WotLK-HD's renderer and interface.
disabled_patches=$WOW_ROOT/client/patches/retail-creatures-disabled
mkdir -p "$disabled_patches/Data/enUS"
for patch in Data/patch-4.MPQ Data/enUS/patch-enUS-4.MPQ; do
	if [ -f "$WOW_ROOT/client/hd/$patch" ]; then
		mv -f "$WOW_ROOT/client/hd/$patch" "$disabled_patches/$patch"
	fi
done

"$(dirname -- "$0")/install-addons"
echo "wow: HD client built at $WOW_ROOT/client/hd"
