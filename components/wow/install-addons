#!/bin/sh
set -eu
. "$(dirname -- "$0")/common.sh"
require_radium

target=$WOW_ROOT/client/hd/Interface/AddOns
sources=$WOW_ROOT/source/addons
[ -f "$WOW_ROOT/client/hd/Wow-hd.exe" ] || { echo "wow: build the HD client before installing addons" >&2; exit 1; }
mkdir -p "$target"

# This local preset was useful while evaluating an FFXIV-style crossbar, but
# the active controller setup now deliberately uses ConsolePortLK's stock Xbox
# profile. Keep rebuilds from resurrecting the retired preset.
rm -rf "$target/AzerothFFXIVController"

# The wotlk-hd builder also installs a Retail-style UI addon. Its action bars,
# bags, map, and unit frames compete with ConsolePortLK for the same protected
# frames. Radium uses only the patched executable and renderer DLL, so keep the
# WotlkHD addon outside the loadable addon tree.
rm -rf "$target/WotlkHD"

copy_tree() {
	source=$1 destination=$2
	mkdir -p "$destination"
	rsync -a --delete --exclude=.git "$source/" "$destination/"
}

for addon in "$sources/ConsolePortLK"/*; do
	[ -d "$addon" ] && find "$addon" -maxdepth 1 -name '*.toc' -print -quit | grep -q . || continue
	copy_tree "$addon" "$target/$(basename "$addon")"
done

# Preserve the stock Xbox layout, changing only logical X from Action Button 1
# to Awesome WotLK's smart interaction binding. A remains the stock Jump button.
xbox_profile=$target/ConsolePort/Controllers/XBOX/Xbox.lua
[ -f "$xbox_profile" ] || { echo "wow: missing ConsolePort Xbox profile" >&2; exit 1; }
sed -i "/\['CP_R_LEFT'\] = {/ , /},/ s/= 'ACTIONBUTTON1'/= 'INTERACTIONKEYBIND'/" "$xbox_profile"
grep -q "= 'INTERACTIONKEYBIND'" "$xbox_profile" || {
	echo "wow: failed to install Awesome smart interaction binding" >&2
	exit 1
}

# Awesome WotLK is a client extension, not an addon replacement. Its optional
# settings UI is installed from the pinned source checkout when present; the
# executable patch and DLL remain operator-supplied runtime data on Hive.
if [ -d "$sources/awesome-wotlk/addons/AwesomeCVar" ]; then
	copy_tree "$sources/awesome-wotlk/addons/AwesomeCVar" "$target/AwesomeCVar"
fi
# Immersion-WotLK replaces DialogUI; never load both quest/gossip frame owners.
rm -rf "$target/DialogUI"
[ -f "$sources/Immersion-WotLK/Immersion/Immersion.toc" ] || {
	echo "wow: missing pinned Immersion-WotLK source" >&2
	exit 1
}
copy_tree "$sources/Immersion-WotLK/Immersion" "$target/Immersion"
# Pinned upstream 1.4.14 contains ConsolePort support but accidentally omits
# its loader from the TOC. Load it last, after the frames it augments exist.
immersion_toc=$target/Immersion/Immersion.toc
if ! grep -Fq 'Logic\Controller.lua' "$immersion_toc"; then
	sed -i '$aLogic\\Controller.lua' "$immersion_toc"
fi

# Radium's small first-party layout layer keeps stock ConsolePort behavior while
# reserving comfortable screen regions for the RP6. It contains no game assets.
copy_tree "$(dirname -- "$0")/addons/RadiumCouchUI" "$target/RadiumCouchUI"

copy_tree "$sources/MultiBot" "$target/MultiBot"
copy_tree "$sources/Chatter-Companion" "$target/Chatter"
for suite in AtlasLootEnhanced DBM-Warmane; do
	for addon in "$sources/$suite"/*; do
		[ -d "$addon" ] && find "$addon" -maxdepth 1 -name '*.toc' -print -quit | grep -q . || continue
		copy_tree "$addon" "$target/$(basename "$addon")"
	done
done

echo "wow: pinned 3.3.5a addons installed in $target"
