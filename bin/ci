#!/bin/sh
# Local checks only; all deployment fixtures use disposable homes.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
case "${1-}" in
    '') ;;
    --integration)
        for tool in chezmoi age age-keygen fish niri noctalia wlr-which-key systemd-analyze nvim tmux; do
            command -v "$tool" >/dev/null 2>&1 || { echo "bin/ci: missing integration prerequisite: $tool; see docs/development.md" >&2; exit 1; }
        done
        export DOTAWESOME_INTEGRATION=1
        ;;
    *) echo 'Usage: bin/ci [--integration]' >&2; exit 2 ;;
esac
for tool in go gitleaks; do
    command -v "$tool" >/dev/null 2>&1 || { echo "bin/ci: missing required tool: $tool; see docs/development.md" >&2; exit 1; }
done
unformatted=$(gofmt -l cmd internal)
[ -z "$unformatted" ] || { printf 'Run gofmt on:\n%s\n' "$unformatted" >&2; exit 1; }
go vet ./...
go test -race -count=1 ./...
bin/check-secrets
