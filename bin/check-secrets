#!/usr/bin/env python3
"""Redacted Gitleaks scan of the index, or tracked working content."""
import argparse
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--staged', action='store_true')
args = parser.parse_args()
if not shutil.which('gitleaks'):
    sys.exit('check-secrets: gitleaks is required; install explicitly: sudo pacman -S gitleaks')
try:
    root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
    base = ['gitleaks', '--redact=100', '--no-banner', '--no-color', '--ignore-gitleaks-allow',
            '--config', str(root / '.gitleaks.toml')]
    if args.staged:
        result = subprocess.run(base + ['git', '--pre-commit', '--staged', str(root)])
    else:
        # dir mode scans exact tracked working content, including local modifications.
        paths = subprocess.check_output(['git', '-C', str(root), 'ls-files', '--cached', '--others', '--exclude-standard', '-z']).decode().split('\0')
        with tempfile.TemporaryDirectory(prefix='dotawesome-secret-scan-') as tmp:
            directory = Path(tmp)
            for name in filter(None, paths):
                source = root / name
                if source.is_symlink() or not source.is_file():
                    continue
                destination = directory / name
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(source, destination)
            result = subprocess.run(base + ['dir', str(directory)])
    sys.exit(result.returncode)
except (OSError, subprocess.CalledProcessError) as exc:
    sys.exit(f'check-secrets: {exc}')
