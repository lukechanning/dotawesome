#!/usr/bin/env bash
set -euo pipefail

url=https://127.0.0.1:8483
ssh -F /dev/null -o ExitOnForwardFailure=yes \
    -L 127.0.0.1:8483:127.0.0.1:8483 -N luke@radium &
tunnel_pid=$!
trap 'kill "$tunnel_pid" 2>/dev/null || true' EXIT

sleep 1
if ! kill -0 "$tunnel_pid" 2>/dev/null; then
    wait "$tunnel_pid"
    exit 1
fi

printf 'Steam Headless dashboard: %s\nPress Ctrl-C to close the tunnel.\n' "$url"
if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
fi
wait "$tunnel_pid"
